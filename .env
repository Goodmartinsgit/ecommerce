# API Configuration
# For local development
VITE_API_BASE_URL=http://localhost:5000/api/

# For production, set this in Vercel environment variables:
# VITE_API_BASE_URL=https://ecombackend-xpdc.onrender.com/api/

# Flutterwave Configuration
# Get your TEST public key from: https://dashboard.flutterwave.com/settings/apis
# Replace with your actual Flutterwave TEST public key (starts with FLWPUBK_TEST-)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-71134ba50d07922c0860525fb18f44d1-X

# For production, set this in Vercel environment variables:
# VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-live-public-key-here
