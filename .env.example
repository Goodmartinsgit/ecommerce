# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api/

# Flutterwave Configuration
# Get your keys from: https://dashboard.flutterwave.com/settings/apis
# For development, use TEST keys (FLWPUBK_TEST-...)
# For production, use LIVE keys (FLWPUBK-...)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your-public-key-here' with your actual Flutterwave public key
# 3. Restart the development server (npm run dev)
