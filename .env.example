# API Configuration
# Update this to match your backend API URL
VITE_API_BASE_URL=http://localhost:5000/api/

# For production, update to your production API URL
# VITE_API_BASE_URL=https://your-api-domain.com/api/

# Flutterwave Configuration
# Add your Flutterwave public key here
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here

# For production, use your live public key
# VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-live-public-key-here
